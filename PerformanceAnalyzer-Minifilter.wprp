<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder
    Author="PerformanceAnalyzer"
    Company="PerformanceAnalyzer"
    Version="1.0">
  <Profiles>
    <SystemCollector
        Id="PerformanceAnalyzerMiniFilterCollector"
        Name="NT Kernel Logger">
      <BufferSize Value="1024"/>
      <Buffers Value="256"/>
    </SystemCollector>

    <SystemProvider Id="PerformanceAnalyzerMiniFilterProvider">
      <Keywords>
        <Keyword Value="DiskIO"/>
        <Keyword Value="Drivers"/>
        <Keyword Value="FileIO"/>
        <Keyword Value="FileIOInit"/>
        <Keyword Value="FilterIO"/>
        <Keyword Value="FilterIOFailure"/>
        <Keyword Value="FilterIOFastIO"/>
        <Keyword Value="FilterIOInit"/>
        <Keyword Value="Loader"/>
        <Keyword Value="ProcessThread"/>
      </Keywords>
    </SystemProvider>

    <Profile
        Description="Bounded minifilter, file, process, and disk I/O capture"
        DetailLevel="Light"
        Id="PerformanceAnalyzerMiniFilter.Light.Memory"
        LoggingMode="Memory"
        Name="PerformanceAnalyzerMiniFilter">
      <ProblemCategories>
        <ProblemCategory Value="Scenario Analysis"/>
      </ProblemCategories>
      <Collectors>
        <SystemCollectorId Value="PerformanceAnalyzerMiniFilterCollector">
          <SystemProviderId Value="PerformanceAnalyzerMiniFilterProvider"/>
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
